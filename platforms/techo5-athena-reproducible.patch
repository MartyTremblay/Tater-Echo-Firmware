--- a/tools/linux/athena/mkstore.sh
+++ b/tools/linux/athena/mkstore.sh
@@ -123,10 +123,12 @@
 	{ echo "mkstore: the rootfs has no athena device.conf (DEVICE_OVERLAY=tools/linux/athena/overlay)" >&2; exit 1; }
 printf '%s\n' "$STATE" > "$R/slots/a.state"
 echo a > "$R/active"
-echo "athena store built $(date -u '+%Y-%m-%dT%H:%MZ'); slot a: $(cat "$R/slots/a/etc/techo5-release")" > "$R/etc/techo5-store-release"
+: "${SOURCE_DATE_EPOCH:?SOURCE_DATE_EPOCH is required for a reproducible store}"
+built=$(date -u -d "@$SOURCE_DATE_EPOCH" '+%Y-%m-%dT%H:%MZ')
+echo "athena store built $built; slot a: $(cat "$R/slots/a/etc/techo5-release")" > "$R/etc/techo5-store-release"
 
 # Size: the contents plus room for logs of slotctl's own writes and a margin; inodes likewise.
-used=$(du -s --block-size=1M "$R" | cut -f1)
+used=$(du -sm "$R" | cut -f1)
 files=$(find "$R" | wc -l)
 size=$(( (used * 115 / 100 + 64 + 3) / 4 * 4 ))
 inodes=$(( files * 13 / 10 + 4096 ))
@@ -137,6 +139,7 @@
 # with one left to zero ("marked as needing zeroing") as having errors each time it mounts it, and then
 # refuses to grow it, so a unit on that kernel stayed at this size and could not take an update (#192).
 mke2fs -q -t ext4 -b 4096 -I 256 -N "$inodes" -L "$LABEL" -m 0 \
+	-U 00000000-0000-0000-0000-000000000000 \
 	-O none,ext_attr,resize_inode,dir_index,filetype,extent,sparse_super,large_file,huge_file,uninit_bg,dir_nlink,extra_isize \
-	-E root_owner=0:0,lazy_itable_init=0 -d "$R" "$OUT" "${size}M"
+	-E hash_seed=00000000-0000-0000-0000-000000000001,root_owner=0:0,lazy_itable_init=0 -d "$R" "$OUT" "${size}M"
 # The nodes the kernel opens before /init has mounted /dev.
@@ -154,4 +157,4 @@
 e2fsck -fn "$OUT" >/dev/null
 say "fsck clean; $(dumpe2fs -h "$OUT" 2>/dev/null | grep -E '^Filesystem features' | tr -s ' ')"
 say "free: $(dumpe2fs -h "$OUT" 2>/dev/null | awk -F: '/^Free blocks/ {printf "%d MiB", $2*4/1024}')"
-say "$OUT: $(du -h --apparent-size "$OUT" | cut -f1)"
+say "$OUT: $(du -h "$OUT" | cut -f1)"
